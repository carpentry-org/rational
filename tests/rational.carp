(load "rational.carp")
(load "Test.carp")

(use-all Rational Test)

(defn cross-lt [a b]
  (Int.< (* @(numerator a) @(denominator b)) (* @(numerator b) @(denominator a))))

(defn lt-mismatches []
  (let-do [bad 0]
    (for [na -12 13]
      (for [da 1 13]
        (for [nb -12 13]
          (for [db 1 13]
            (let [x (new na da)
                  y (new nb db)]
              (when (/= (< &x &y) (cross-lt &x &y)) (set! bad (Int.inc bad))))))))
    bad))

(defn modulo-mismatches []
  (let-do [bad 0]
    (for [na -8 9]
      (for [da 1 9]
        (for [nb -8 9]
          (for [db 1 9]
            (when (/= nb 0)
              (let [x (new na da)
                    y (new nb db)
                    want (sub &x &(mul &(from-int (to-int &(div &x &y))) &y))]
                (when (/= &(modulo &x &y) &want) (set! bad (Int.inc bad)))))))))
    bad))

(defn ascending? [a]
  (let-do [ok true]
    (for [i 1 (Array.length a)]
      (unless (< (Array.unsafe-nth a (Int.dec i)) (Array.unsafe-nth a i))
        (set! ok false)))
    ok))

(defn main []
  (with-test test
    (assert-equal test
      &(new 1 4)
      &(from-float 0.25f)
      "can convert correctly from float")
    (assert-equal test
      0.25f
      (to-float &(new 1 4))
      "can convert correctly to float")
    (assert-equal test
      &(new 1 4)
      &(from-double 0.25)
      "can convert correctly from double")
    (assert-equal test
      0.25
      (to-double &(new 1 4))
      "can convert correctly to double")
    (assert-equal test
      &(new 1 1)
      &(from-double 1.0)
      "from-double converts a whole number")
    (assert-true test
      (Double.<
        (Double.abs
          (Double.-
            (to-double &(from-double (Double.sqrt 2.0)))
            (Double.sqrt 2.0)))
        0.0001)
      "from-double approximates an irrational closely without overflowing")
    (assert-equal test
      &(new 1 3)
      &(from-float (/ 1f 3f))
      "from-float recovers 1/3 instead of overflowing")
    (assert-equal test
      &(new 355 113)
      &(rationalize 3.1415926535897931 300)
      "rationalize finds 355/113 for pi under a denominator bound of 300")
    (assert-equal test
      &(new 1 2)
      &(rationalize 0.5 100)
      "rationalize returns the simplest fraction for 0.5")
    (assert-equal test
      &(new 123456789 10000)
      &(from-double 12345.678900000001)
      "from-double keeps a moderate-magnitude decimal exact")
    (assert-true test
      (Double.<
        (Double./
          (Double.abs
            (Double.- (to-double &(from-double 100000000.333)) 100000000.333))
          100000000.333)
        0.001)
      "from-double keeps a large-magnitude value close without numerator overflow")
    (assert-true test
      (Double.<
        (Double./
          (Double.abs
            (Double.-
              (to-double &(from-double 987654.32198699994))
              987654.32198699994))
          987654.32198699994)
        0.001)
      "from-double approximates a large non-terminating value without corruption")
    (assert-equal test
      &(from-int 0)
      &(from-double (/ 0.0 0.0))
      "from-double maps NaN to 0/1 (and terminates instead of hanging)")
    (assert-equal test
      &(new 1073741824 1)
      &(from-double (/ 1.0 0.0))
      "from-double clamps +Inf to the largest representable rational")
    (assert-equal test
      &(new -1073741824 1)
      &(from-double (/ -1.0 0.0))
      "from-double clamps -Inf to the smallest representable rational")
    (assert-equal test
      1073741824
      (to-int &(from-double (/ 1.0 0.0)))
      "to-int of a clamped infinity has a non-zero denominator, so it never SIGFPEs")
    (assert-equal test
      &(new 1073741824 1)
      &(from-double 3000000000.0)
      "from-double clamps a finite magnitude beyond 2^31 instead of overflowing to garbage")
    (assert-equal test
      &(new -1073741824 1)
      &(from-double -3000000000.0)
      "from-double clamps a large negative magnitude instead of overflowing")
    (assert-equal test
      &(new 12 1)
      &(from-int 12)
      "can convert correctly from int")
    (assert-equal test 1 (to-int &(new 1 1)) "can convert correctly to int")

    (assert-equal test &(new 1 2) &(new 3 6) "new reduces to lowest terms")
    (assert-equal test
      &(new -1 2)
      &(new 1 -2)
      "new normalizes negative denominator")
    (assert-equal test &(new 1 2) &(new -1 -2) "new normalizes double negative")

    (assert-equal test
      &(new 11 18)
      &(add &(new 1 9) &(new 3 6))
      "can add correctly")
    (assert-equal test
      &(new 5 3)
      &(sub &(new 6 3) &(new 2 6))
      "can subtract correctly")
    (assert-equal test
      &(new 3 16)
      &(mul &(new 1 8) &(new 3 2))
      "can multiply correctly")
    (assert-equal test
      &(new 3 4)
      &(div &(new 3 1) &(new 8 2))
      "can divide correctly")
    (assert-equal test
      &(new 2 1)
      &(div &(new 3 1) &(new 3 2))
      "div with non-unit denominator")
    (assert-equal test
      &(new 5 6)
      &(div &(new 1 3) &(new 2 5))
      "div fractions by fractions")
    (assert-equal test
      &(new 3 20)
      &(modulo &(new 12 5) &(new 3 4))
      "can modulo correctly")
    (assert-equal test
      &(new -3 20)
      &(modulo &(new -12 5) &(new 3 4))
      "modulo carries the sign of the dividend")
    (assert-equal test
      &(new 3 20)
      &(modulo &(new 12 5) &(new -3 4))
      "modulo ignores the sign of the divisor")
    (assert-equal test
      &(new -3 20)
      &(modulo &(new -12 5) &(new -3 4))
      "modulo of two negatives is negative")
    (assert-equal test
      &(new 1 3)
      &(modulo &(new 1 3) &(new 1 2))
      "modulo returns the dividend when it is smaller than the divisor")
    (assert-equal test
      &(new 0 1)
      &(modulo &(new 100000 1) &(new 1 100000))
      "modulo of an exact multiple is zero even when the quotient overflows")
    (assert-equal test
      &(new 1 50000)
      &(modulo &(new 50000 1) &(new 3 50000))
      "modulo is exact when the quotient exceeds 2^31")
    (assert-equal test
      0
      (modulo-mismatches)
      "modulo agrees with a - trunc(a/b)*b on every small fraction pair")

    ; arithmetic cancels common factors before multiplying, so a reduced result
    ; that is perfectly representable is not corrupted by an intermediate product
    ; overflowing 32-bit `Int`.
    (assert-equal test
      &(new 2 46341)
      &(add &(new 1 46341) &(new 1 46341))
      "add does not overflow when the naive common denominator exceeds 2^31")
    (assert-equal test
      &(new 1 48000)
      &(add &(new 1 120000) &(new 1 80000))
      "add reduces unequal denominators before multiplying to avoid overflow")
    (assert-equal test
      &(new -1 240000)
      &(sub &(new 1 120000) &(new 1 80000))
      "sub reduces unequal denominators before multiplying to avoid overflow")
    (assert-equal test
      &(new 4 9)
      &(mul &(new 46342 69519) &(new 46346 69513))
      "mul cross-cancels so both naive products overflowing 2^31 still yields 4/9")
    (assert-equal test
      &(new 4 9)
      &(div &(new 46342 69519) &(new 69513 46346))
      "div cross-cancels so both naive products overflowing 2^31 still yields 4/9")

    (assert-true test (< &(new 1 3) &(new 1 2)) "< with same sign")
    (assert-false test (< &(new 1 2) &(new 1 3)) "not < when greater")
    (assert-false test (< &(new 1 2) &(new 1 2)) "not < when equal")
    (assert-true test (> &(new 1 2) &(new 1 3)) "> works")
    (assert-true test (< &(new -1 2) &(new 1 2)) "< with negative")

    (assert-equal test &(new -3 4) &(neg (new 3 4)) "neg positive")
    (assert-equal test &(new 3 4) &(neg (new -3 4)) "neg negative")
    (assert-equal test &(new 3 4) &(abs (new -3 4)) "abs negative")
    (assert-equal test &(new 3 4) &(abs (new 3 4)) "abs positive")

    (assert-equal test &(new 2 1) &(floor (new 6 3)) "floor of an exact integer")
    (assert-equal test
      &(new 0 1)
      &(floor (new 1 3))
      "floor of a positive fraction")
    (assert-equal test
      &(new 3 1)
      &(floor (new 7 2))
      "floor rounds positive down")
    (assert-equal test
      &(new -1 1)
      &(floor (new -1 3))
      "floor of a negative fraction")
    (assert-equal test
      &(new -4 1)
      &(floor (new -7 2))
      "floor rounds negative toward -inf")
    (assert-equal test
      &(new -2 1)
      &(floor (new -6 3))
      "floor of a negative exact integer")

    (assert-equal test &(new 2 1) &(ceil (new 6 3)) "ceil of an exact integer")
    (assert-equal test
      &(new 1 1)
      &(ceil (new 1 3))
      "ceil of a positive fraction")
    (assert-equal test &(new 4 1) &(ceil (new 7 2)) "ceil rounds positive up")
    (assert-equal test
      &(new 0 1)
      &(ceil (new -1 3))
      "ceil of a negative fraction")
    (assert-equal test
      &(new -3 1)
      &(ceil (new -7 2))
      "ceil rounds negative toward +inf")

    (assert-equal test &(new 2 1) &(round (new 6 3)) "round of an exact integer")
    (assert-equal test
      &(new 0 1)
      &(round (new 1 3))
      "round of a value below a half")
    (assert-equal test
      &(new 1 1)
      &(round (new 2 3))
      "round of a value above a half")
    (assert-equal test
      &(new 2 1)
      &(round (new 3 2))
      "round of a half goes away from zero")
    (assert-equal test &(new 3 1) &(round (new 5 2)) "round of a larger half")
    (assert-equal test
      &(new -1 1)
      &(round (new -2 3))
      "round of a negative above a half")
    (assert-equal test
      &(new -2 1)
      &(round (new -3 2))
      "round of a negative half goes away from zero")
    (assert-equal test
      &(new -3 1)
      &(round (new -5 2))
      "round of a larger negative half")
    (assert-equal test
      &(new 1500000000 1)
      &(round (new 1500000000 1))
      "round of a large exact integer does not overflow")
    (assert-equal test
      &(new -1500000000 1)
      &(round (new -1500000000 1))
      "round of a large negative exact integer does not overflow")
    (assert-equal test
      &(new 1000000001 1)
      &(round (new 2000000001 2))
      "round of a large half rounds away from zero without overflow")

    (assert-equal test "(Rational 3/2)" &(str &(new 3 2)) "can stringify")
    (assert-equal test
      "(Rational -1/2)"
      &(str &(new 1 -2))
      "stringify negative denominator normalizes")
    (assert-equal test 12 (hash &(new 12 1)) "can hash")

    (assert-equal test
      &(Maybe.Just (new 3 4))
      &(Rational.from-string "3/4")
      "from-string parses a simple fraction")
    (assert-equal test
      &(Maybe.Just (new 3 4))
      &(Rational.from-string "6/8")
      "from-string reduces to lowest terms")
    (assert-equal test
      &(Maybe.Just (new -2 7))
      &(Rational.from-string "-2/7")
      "from-string parses a negative numerator")
    (assert-equal test
      &(Maybe.Just (new -3 4))
      &(Rational.from-string "6/-8")
      "from-string normalizes a negative denominator")
    (assert-equal test
      &(Maybe.Just (new 5 1))
      &(Rational.from-string "5")
      "from-string parses a bare integer")
    (assert-equal test
      &(Maybe.Just (new -5 1))
      &(Rational.from-string "-5")
      "from-string parses a negative bare integer")
    (assert-equal test
      &(Maybe.Just (new 0 1))
      &(Rational.from-string "0/4")
      "from-string parses a zero numerator")
    (assert-equal test
      &(Maybe.Nothing)
      &(Rational.from-string "")
      "from-string rejects the empty string")
    (assert-equal test
      &(Maybe.Nothing)
      &(Rational.from-string "/4")
      "from-string rejects an empty numerator")
    (assert-equal test
      &(Maybe.Nothing)
      &(Rational.from-string "3/")
      "from-string rejects an empty denominator")
    (assert-equal test
      &(Maybe.Nothing)
      &(Rational.from-string "3/0")
      "from-string rejects a zero denominator")
    (assert-equal test
      &(Maybe.Nothing)
      &(Rational.from-string "a/b")
      "from-string rejects non-numeric input")
    (assert-equal test
      &(Maybe.Nothing)
      &(Rational.from-string "3/4/5")
      "from-string rejects too many components")
    (assert-equal test
      &(Maybe.Nothing)
      &(Rational.from-string "abc")
      "from-string rejects a non-numeric bare token")

    (assert-equal test
      &(new 4 3)
      &(reciprocal &(new 3 4))
      "reciprocal of a positive fraction")
    (assert-equal test
      &(new -4 3)
      &(reciprocal &(new -3 4))
      "reciprocal keeps the sign on the numerator")
    (assert-equal test
      &(new 1 5)
      &(reciprocal &(new 5 1))
      "reciprocal of an integer")
    (assert-equal test
      &(new 3 4)
      &(reciprocal &(reciprocal &(new 3 4)))
      "reciprocal is its own inverse")

    (assert-equal test
      &(new 8 27)
      &(Rational.pow &(new 2 3) 3)
      "pow with a positive exponent")
    (assert-equal test
      &(new 1 1)
      &(Rational.pow &(new 5 7) 0)
      "anything to the zeroth power is one")
    (assert-equal test
      &(new 2 3)
      &(Rational.pow &(new 2 3) 1)
      "the first power is the identity")
    (assert-equal test
      &(new 9 4)
      &(Rational.pow &(new 2 3) -2)
      "a negative exponent inverts the base")
    (assert-equal test
      &(new 9 16)
      &(Rational.pow &(new -3 4) 2)
      "pow of a negative base with an even exponent is positive")
    (assert-equal test
      &(new -27 64)
      &(Rational.pow &(new -3 4) 3)
      "pow of a negative base with an odd exponent stays negative")
    (assert-equal test
      &(new -3 2)
      &(Rational.pow &(new -2 3) -1)
      "pow -1 is the signed reciprocal")

    (assert-equal test &(new 1 1) &(sign (new 3 4)) "sign of a positive is 1")
    (assert-equal test &(new -1 1) &(sign (new -3 4)) "sign of a negative is -1")
    (assert-equal test &(new 0 1) &(sign (new 0 5)) "sign of zero is 0")

    (assert-true test (Rational.pos? &(new 3 4)) "pos? holds for a positive")
    (assert-false test (Rational.pos? &(new -3 4)) "pos? rejects a negative")
    (assert-false test (Rational.pos? &(new 0 5)) "pos? rejects zero")
    (assert-true test (Rational.neg? &(new -3 4)) "neg? holds for a negative")
    (assert-false test (Rational.neg? &(new 3 4)) "neg? rejects a positive")
    (assert-false test (Rational.neg? &(new 0 5)) "neg? rejects zero")
    (assert-true test (Rational.zero? &(new 0 5)) "zero? holds for zero")
    (assert-false test (Rational.zero? &(new 3 4)) "zero? rejects a positive")
    (assert-false test (Rational.zero? &(new -3 4)) "zero? rejects a negative")
    ; the predicates read the reduced, sign-normalized result of `new`, so they
    ; track the sign of a computed value, not just a literal.
    (assert-true test
      (Rational.neg? &(sub &(new 1 4) &(new 1 2)))
      "neg? tracks a computed negative")
    (assert-true test
      (Rational.zero? &(sub &(new 1 2) &(new 1 2)))
      "zero? tracks a computed zero")

    ; `zero` is 0/1, not the 0/0 a naive derive would produce, so arithmetic
    ; against it is well-defined rather than a division by zero.
    (assert-equal test &(new 0 1) &(Rational.zero) "zero is 0/1")
    (assert-true test
      (Rational.zero? &(Rational.zero))
      "zero? holds for the zero constructor")
    (assert-equal test
      &(new 3 4)
      &(add &(new 3 4) &(Rational.zero))
      "adding zero is the identity")
    (assert-equal test
      &(new 3 4)
      &(sub &(new 3 4) &(Rational.zero))
      "subtracting zero is the identity")
    (assert-equal test
      &(Rational.zero)
      &(mul &(new 3 4) &(Rational.zero))
      "multiplying by zero is zero")

    ; comparisons cross-multiply, so equal-valued but differently-written
    ; fractions compare as equal.
    (assert-true test
      (Rational.<= &(new 1 2) &(new 2 3))
      "<= holds when strictly less")
    (assert-true test
      (Rational.<= &(new 2 4) &(new 1 2))
      "<= holds for equal values written differently")
    (assert-false test
      (Rational.<= &(new 2 3) &(new 1 2))
      "<= rejects a greater value")
    (assert-true test
      (Rational.>= &(new 2 3) &(new 1 2))
      ">= holds when strictly greater")
    (assert-true test
      (Rational.>= &(new 1 2) &(new 2 4))
      ">= holds for equal values written differently")
    (assert-false test
      (Rational.>= &(new 1 2) &(new 2 3))
      ">= rejects a lesser value")

    (assert-equal test
      &(new 1 2)
      &(Rational.min &(new 1 2) &(new 2 3))
      "min returns the smaller argument")
    (assert-equal test
      &(new 1 2)
      &(Rational.min &(new 2 3) &(new 1 2))
      "min does not depend on argument order")
    (assert-equal test
      &(new 1 3)
      &(Rational.min &(new 2 4) &(new 1 3))
      "min reduces and compares, picking 1/3 over 1/2")
    (assert-equal test
      &(new -3 4)
      &(Rational.min &(new -3 4) &(new 1 5))
      "min handles negative values")
    (assert-equal test
      &(new 2 3)
      &(Rational.max &(new 1 2) &(new 2 3))
      "max returns the larger argument")
    (assert-equal test
      &(new 2 3)
      &(Rational.max &(new 2 3) &(new 1 2))
      "max does not depend on argument order")
    (assert-equal test
      &(new -1 5)
      &(Rational.max &(new -3 4) &(new -1 5))
      "max of two negatives picks the one closer to zero")
    (assert-equal test
      &(new 1 2)
      &(Rational.max &(new 1 2) &(new 1 2))
      "max of equal values is that value")

    (assert-equal test
      &(new 1 2)
      &(Rational.clamp &(new 0 1) &(new 1 1) &(new 1 2))
      "clamp leaves a value already in range untouched")
    (assert-equal test
      &(new 0 1)
      &(Rational.clamp &(new 0 1) &(new 1 1) &(new -3 4))
      "clamp raises a value below the lower bound")
    (assert-equal test
      &(new 1 1)
      &(Rational.clamp &(new 0 1) &(new 1 1) &(new 3 2))
      "clamp lowers a value above the upper bound")
    (assert-equal test
      &(new 1 4)
      &(Rational.clamp &(new 1 4) &(new 3 4) &(new 1 4))
      "clamp keeps a value sitting on the lower bound")
    (assert-equal test
      &(new 3 4)
      &(Rational.clamp &(new 1 4) &(new 3 4) &(new 3 4))
      "clamp keeps a value sitting on the upper bound")

    (assert-false test
      (< &(new 46339 1) &(new 1 46339))
      "46339/1 is not below 1/46339")
    (assert-false test
      (< &(new 46340 1) &(new 1 46340))
      "46340/1 is not below 1/46340")
    (assert-false test
      (< &(new 46341 1) &(new 1 46341))
      "46341/1 is not below 1/46341, where the cross product first overflows")
    (assert-false test
      (< &(new 46342 1) &(new 1 46342))
      "46342/1 is not below 1/46342")
    (assert-true test
      (< &(new 1 46341) &(new 46341 1))
      "1/46341 is below 46341/1")
    (assert-true test
      (< &(new -46341 1) &(new 1 46341))
      "a large negative is below a tiny positive")
    (assert-false test
      (< &(new 46341 1) &(new -1 46341))
      "a large positive is not below a tiny negative")
    (assert-true test
      (< &(new -46341 1) &(new -1 46341))
      "a large negative is below a tiny negative")
    (assert-false test
      (< &(new -1 46341) &(new -46341 1))
      "a tiny negative is not below a large negative")
    (assert-false test
      (< &(new 46341 46342) &(new 46341 46342))
      "a large fraction is not below itself")
    (assert-true test
      (<= &(new 46341 46342) &(new 46341 46342))
      "<= holds for a large fraction and itself")
    (assert-true test
      (< &(new 46341 46342) &(new 46342 46343))
      "neighbouring large fractions are ordered by their distance to one")
    (assert-true test
      (< &(new 46330 46333) &(new 46349 46350))
      "two fractions just below one are ordered by their distance to it")
    (assert-true test
      (< &(new 1234567890 1234567891) &(new 1234567891 1234567892))
      "two fractions differing beyond the ninth digit are still ordered exactly")
    (assert-true test
      (< &(new 0 1) &(new 1 2147483647))
      "zero is below the smallest positive fraction")
    (assert-true test
      (< &(new -1 2147483647) &(new 0 1))
      "the largest negative fraction is below zero")
    (assert-true test
      (< &(new 2147483646 2147483647) &(new 1 1))
      "a fraction just under one is below one")
    (assert-false test
      (< &(new 1 1) &(new 2147483646 2147483647))
      "one is not below a fraction just under one")
    (assert-true test
      (< &(new 1 2) &(new 1 0))
      "a zero denominator compares as an infinite magnitude instead of dividing")
    (assert-true test
      (< &(new -1 0) &(new 1 2))
      "a negative zero denominator compares below every finite fraction")
    (assert-equal test
      &(new 1 46341)
      &(Rational.min &(new 46341 1) &(new 1 46341))
      "min picks the tiny fraction over the huge one")
    (assert-equal test
      &(new 46341 1)
      &(Rational.max &(new 46341 1) &(new 1 46341))
      "max picks the huge fraction over the tiny one")
    (assert-equal test
      &(new 1 46341)
      &(Rational.clamp &(new -46341 1) &(new 1 46341) &(new 46341 1))
      "clamp lowers a huge value onto a tiny upper bound")
    (assert-equal test
      &[(new 1 100000) (new 1 46341) (new 1 2) (new 3 1) (new 46341 1)]
      &(Array.sorted
        &[(new 1 46341) (new 46341 1) (new 1 2) (new 3 1) (new 1 100000)])
      "sorted orders a mix of tiny and huge fractions ascending")
    (assert-true test
      (ascending?
        &(Array.sorted
          &[(new 46330 46331)
            (new 46349 46350)
            (new 46330 46333)
            (new 46350 46351)
            (new 46349 46352)]))
      "sorted orders fractions that differ only just below one")
    (assert-equal test
      0
      (lt-mismatches)
      "the exact comparison agrees with cross-multiplication on every small fraction pair")))
